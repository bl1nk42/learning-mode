{
  "mcpServers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp?client=claude-code-plugin",
      "headers": {
        "Authorization": "${CONTEXT7_API_KEY:-}"
      }
    },
    "sourcegraph": {
      "type": "http",
      "url": "https://sourcegraph.com/.api/mcp",
      "headers": {
        "Authorization": "${SOURCEGRAPH_ACCESS_TOKEN:-}"
      }
    },
    "qmd": {
      "command": "npx",
      "args": ["-y", "qmd-mcp@latest"]
    }
  }
}
