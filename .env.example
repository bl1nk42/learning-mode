# Learning Mode Environment Variables

# Root directory for all learning mode data
# Default: ~/.learning-mode
LEARNING_MODE_HOME=

# Vault path for insight storage (overrides config.json vaultPath)
# Default: ~/.learning-mode (or from ~/.learning-mode/config.json)
LEARNING_MODE_VAULT=

# Claude config directory (used by hooks to find plugin root)
# Default: ~/.claude
CLAUDE_CONFIG_DIR=

# MCP Server API Keys
CONTEXT7_API_KEY=
SOURCEGRAPH_ACCESS_TOKEN=
