{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/learning-mode/schemas/session-map.schema.json",
  "title": "Learning Mode Session Map",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "session", "meta", "nodes", "edges"],
  "properties": {
    "version": {
      "const": "1.0.0"
    },
    "session": {
      "type": "object",
      "required": ["date"],
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "duration": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "meta": {
      "type": "object",
      "required": ["title", "views"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "locale": {
          "enum": ["th", "en", "zh-CN", "ja", "ko"]
        },
        "quality_profile": {
          "enum": ["standard", "showcase"]
        },
        "views": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "label", "focus"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 48
              },
              "focus": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "note": {
                "type": "string",
                "maxLength": 140
              }
            }
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "name", "content"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(insight|exercise|lesson|concept|resource):[a-zA-Z0-9_-]+$"
          },
          "type": {
            "enum": ["insight", "exercise", "lesson", "concept", "resource"]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "content": {
            "type": "string",
            "minLength": 1
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "difficulty": {
            "enum": ["beginner", "intermediate", "advanced"]
          },
          "source": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target", "type"],
        "properties": {
          "source": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "type": {
            "enum": ["builds_on", "related_to", "contradicts", "prerequisite_of"]
          },
          "description": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    },
    "tour": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["order", "title", "description", "nodeIds"],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "nodeIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "contextLesson": {
            "type": "string",
            "maxLength": 500
          },
          "sourceRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
