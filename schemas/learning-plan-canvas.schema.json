{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Learning Mode Canvas",
  "type": "object",
  "required": [
    "meta",
    "nodes",
    "edges"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "title",
        "locale",
        "repository",
        "schemaVersion"
      ]
    },
    "nodes": {
      "type": "array"
    },
    "edges": {
      "type": "array"
    }
  },
  "additionalProperties": true,
  "x-learning-mode-phase-chain": {
    "nodes": [
      "observed",
      "practice",
      "demonstrated",
      "transfer"
    ],
    "edges": [
      "observed->practice",
      "practice->demonstrated",
      "demonstrated->transfer"
    ]
  }
}
