{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bl1nk42/learning-mode/schemas/learning-plan-canvas.schema.json",
  "title": "Learning Mode Canvas",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta",
    "nodes",
    "edges"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "locale",
        "repository",
        "schemaVersion"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "locale": {
          "type": "string",
          "minLength": 1
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "repository": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "revision"
          ],
          "properties": {
            "url": {
              "type": "string"
            },
            "revision": {
              "type": "string"
            }
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "x",
          "y",
          "width",
          "height"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
          },
          "type": {
            "enum": [
              "file",
              "text",
              "group"
            ]
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "width": {
            "type": "number",
            "minimum": 1
          },
          "height": {
            "type": "number",
            "minimum": 1
          },
          "file": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "fromNode",
          "toNode"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
          },
          "fromNode": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
          },
          "toNode": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
          }
        }
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "fromNode": {
                "const": "observed"
              },
              "toNode": {
                "const": "practice"
              }
            },
            "required": [
              "fromNode",
              "toNode"
            ],
            "type": "object"
          },
          "minContains": 1
        },
        {
          "contains": {
            "properties": {
              "fromNode": {
                "const": "practice"
              },
              "toNode": {
                "const": "demonstrated"
              }
            },
            "required": [
              "fromNode",
              "toNode"
            ],
            "type": "object"
          },
          "minContains": 1
        },
        {
          "contains": {
            "properties": {
              "fromNode": {
                "const": "demonstrated"
              },
              "toNode": {
                "const": "transfer"
              }
            },
            "required": [
              "fromNode",
              "toNode"
            ],
            "type": "object"
          },
          "minContains": 1
        }
      ]
    }
  },
  "x-learning-mode-phase-chain": {
    "nodes": [
      "observed",
      "practice",
      "demonstrated",
      "transfer"
    ],
    "edges": [
      "observed->practice",
      "practice->demonstrated",
      "demonstrated->transfer"
    ]
  }
}
